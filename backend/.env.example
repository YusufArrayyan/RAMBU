# Salin ke backend/.env lalu isi seperlunya.

# Basis data analitik agregat. Bawaan: SQLite di backend/rambu.db
# RAMBU_DATABASE_URL=postgresql+psycopg://user:pass@localhost/rambu
RAMBU_DATABASE_URL=

# Asal frontend yang boleh memanggil API (dipisah koma).
RAMBU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token superadmin darurat untuk panel /admin (opsional). Kosong = hanya akun admin bernama.
RAMBU_ADMIN_TOKEN=

# --- v4: lingkungan, akun, email ---
# development menampilkan kode masuk di layar bila SMTP belum diisi; production tidak pernah.
RAMBU_ENV=development
# Wajib di produksi: kunci induk untuk enkripsi data akun dan hash token.
RAMBU_SECRET_KEY=
RAMBU_AKUN_ENABLED=true
RAMBU_APP_URL=http://localhost:5173
# SMTP untuk tautan masuk dan pengingat email. Kosong = email tidak dikirim.
RAMBU_SMTP_HOST=
RAMBU_SMTP_PORT=587
RAMBU_SMTP_USER=
RAMBU_SMTP_PASSWORD=
RAMBU_SMTP_FROM=RAMBU <noreply@rambu.local>
RAMBU_PENGINGAT_INTERVAL=300
# Web Push (notifikasi saat aplikasi tertutup). Kunci privat VAPID dalam PEM; wajib di produksi.
# Kosong di pengembangan: kunci dibuat otomatis di backend/.keys/vapid.pem.
RAMBU_VAPID_PRIVATE_KEY=
RAMBU_VAPID_SUBJECT=mailto:tim@rambu.local

# Data contoh panel admin (hanya pengembangan). Token masuk admin contoh:
#   contoh-penyunting, contoh-peninjau, contoh-analis, contoh-superadmin, contoh-mitra
# Penyunting mengajukan, peninjau (orang berbeda) menyetujui: aturan dua orang.
RAMBU_SEED_CONTOH=true

# --- Tahap 2 (lapisan AI) ---
# Pembaca dokumen, pewawancara cicilan, uji paham tulisan bebas, dan penjelas.
# AI hanya aktif bila RAMBU_AI_ENABLED=true DAN kredensial Anthropic tersedia.
# Bawaannya mati supaya kunci API di lingkungan tidak terpakai tanpa sengaja.
# Catatan: ANTHROPIC_API_KEY yang sudah ada di lingkungan sistem tidak ditimpa oleh berkas ini.
RAMBU_AI_ENABLED=false
# Penyedia: anthropic (bawaan) atau gemini (tingkat gratis Google AI Studio).
RAMBU_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
RAMBU_MODEL=claude-opus-5-5
# Gemini: kunci dari https://aistudio.google.com. Model cadangan dipakai sekali bila model
# utama kelebihan beban (503/429) atau tidak tersedia untuk kunci ini (404).
GEMINI_API_KEY=
RAMBU_GEMINI_MODEL=gemini-flash-latest
RAMBU_GEMINI_MODEL_CADANGAN=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Batas pemakaian per klien: 12 permintaan per 600 detik.
RAMBU_AI_RATE_LIMIT=12
RAMBU_AI_RATE_WINDOW=600
